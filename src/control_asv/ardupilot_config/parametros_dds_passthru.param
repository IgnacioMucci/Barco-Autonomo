#Config para NodoApJoy

# --- RED ETHERNET HACIA LA PC A BORDO ---
NET_ENABLE, 1
# La IP de la placa (ej. 192.168.0.100). La PC a bordo debe estar en el mismo rango (ej. 192.168.0.101)
# Dirección IP de la placa: 192.168.0.100
NET_IPADDR0, 192
NET_IPADDR1, 168
NET_IPADDR2, 0
NET_IPADDR3, 100

# Máscara de subred: 255.255.255.0
NET_NETMASK0, 255
NET_NETMASK1, 255
NET_NETMASK2, 255
NET_NETMASK3, 0

# --- HABILITAR DDS/ROS 2 ---
DDS_ENABLE, 1

# --- PROPULSORES T200 (PASSTHRU) ---
SERVO1_FUNCTION, 51
SERVO3_FUNCTION, 53

# --- LÍMITES PWM (BLUE ROBOTICS T200) ---
SERVO1_MIN, 1100
SERVO1_TRIM, 1500
SERVO1_MAX, 1900
SERVO3_MIN, 1100
SERVO3_TRIM, 1500
SERVO3_MAX, 1900